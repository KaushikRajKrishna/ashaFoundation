# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored — never commit real keys.

# Web3Forms access key powers the Contact page form (src/components/contact/ContactForm.tsx).
# Get one free at https://web3forms.com — enter the inbox email that should receive
# submissions (e.g. ashafoundationhabra@gmail.com), and they'll email you the key.
# This key is meant to be public/client-side (it's submitted from the browser), so it's
# safe to also set it in Vercel's Environment Variables for the deployed site.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
